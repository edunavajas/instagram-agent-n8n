# Copia este fichero a .env y rellena los valores. .env no se sube al repo.
# Los flujos de n8n NO leen este fichero: la plantilla de Coolify trae
# N8N_BLOCK_ENV_ACCESS_IN_NODE=true, así que $env no funciona dentro de un nodo.
# Lo que se cambia en cámara está en el nodo Configuración de cada flujo, y los
# secretos viven en las credenciales de n8n. Este fichero lo usa
# scripts/send-fake-webhook.sh (IG_WEBHOOK_URL, IG_APP_SECRET, IG_VERIFY_TOKEN)
# y te sirve de lista de todo lo que hay que tener a mano.
# Todos los valores son de ejemplo (<...>): ninguno es real.

# --- Webhook público de n8n (flujo «IG 01 - Webhook») ---
# URL completa que Meta llamará. Para el script de pruebas, la misma.
IG_WEBHOOK_URL=https://<tu-n8n>/webhook/instagram
# Secreto de la app de Meta (App settings > Basic > App Secret).
# En n8n va como variable del contenedor task-runners (no en Configuración):
# con él se verifica X-Hub-Signature-256. El script de pruebas lo usa para firmar.
IG_APP_SECRET=<secreto-de-la-app-de-meta>
# Te lo inventas. El mismo valor va en el panel de Meta y en el campo
# verify_token del nodo Configuración del flujo 01.
IG_VERIFY_TOKEN=<token-de-verificacion-inventado>

# --- Cuenta de Instagram y app de Meta ---
# ID de la cuenta profesional: GET /me/assigned_instagram_accounts?fields=id,username
# (nunca el id de /me, que es el system user).
IG_ACCOUNT_ID=<id-de-la-cuenta-de-instagram>
# Usuario de la cuenta, sin @. Sirve para ignorar los comentarios propios.
IG_USERNAME=<usuario-de-instagram>
# Token del system user (Unified Login). Va en la credencial de n8n
# «Instagram Token» (Header Auth: Authorization = Bearer <token>).
IG_ACCESS_TOKEN=<token-del-system-user>
META_APP_ID=<id-de-la-app-de-meta>

# --- Telegram. Un bot DISTINTO al del correo: un bot solo puede tener un webhook ---
# BotFather: /newbot te da el token. El chat id sale al escribirle al bot y
# abrir https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN_IG=<token-del-bot-de-instagram>
TELEGRAM_CHAT_ID=<id-del-chat>

# --- Modelo (DeepSeek, API compatible con OpenAI) ---
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=<clave-del-modelo>

# --- RAG del episodio 2 ---
# Si el RAG vive en el mismo n8n, n8n se llama a sí mismo por localhost.
RAG_URL=http://localhost:5678/webhook/rag-search
RAG_API_KEY=<la-misma-clave-que-X-RAG-API-Key>

# --- Clave interna entre los flujos de Instagram (te la inventas) ---
# Credencial de n8n «Instagram API Key» (Header Auth, cabecera X-IG-API-Key).
INSTAGRAM_API_KEY=<clave-interna-inventada>

# --- Postgres del episodio 2, para aplicar schema.sql ---
# Host dentro de la red de Coolify: knowledge-db. Desde tu portátil hace falta un túnel.
KNOWLEDGE_DB_HOST=knowledge-db
KNOWLEDGE_DB_PORT=5432
KNOWLEDGE_DB_NAME=knowledge
KNOWLEDGE_DB_USER=<usuario-de-la-base>
KNOWLEDGE_DB_PASSWORD=<contrasena-de-la-base>
